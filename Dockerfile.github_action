FROM python:3.12.10-slim AS base

RUN apt-get update && apt-get install --no-install-recommends -y git curl && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ADD pyproject.toml .
ADD requirements.txt .
# Copy source before packaging install so pip install . has full project metadata/code.
ADD pr_agent pr_agent
# Ensure Azure DevOps runtime dependencies exist in the PR-Agent container.
RUN pip install --no-cache-dir "setuptools<81" \
    && pip install --no-cache-dir -r requirements.txt \
    && pip install --no-cache-dir . \
    && python -c "import pkg_resources, azure.devops, msrest"
RUN rm pyproject.toml requirements.txt
ENV GITHUB__RATELIMIT_RETRIES=5
ENV PYTHONPATH=/app
ADD docs docs
ADD github_action/entrypoint.sh /
RUN chmod +x /entrypoint.sh
ENTRYPOINT ["/entrypoint.sh"]

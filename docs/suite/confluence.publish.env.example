# Optional shell overrides for publish_suite.py (copy to confluence.publish.env and source locally).
# Credentials belong in confluence.publish.toml (gitignored). Env vars override TOML when set.
#
# PowerShell (repo root):
#   Get-Content docs/suite/confluence.publish.env | ForEach-Object {
#     if ($_ -match '^\s*([^#=]+)=(.*)$') { Set-Item -Path "Env:$($matches[1].Trim())" -Value $matches[2].Trim().Trim('"') }
#   }
#
# Or use: docs/suite/publish.ps1

CONFLUENCE_DOMAIN=mdtissues.atlassian.net
CONFLUENCE_SPACE_KEY=MDTS
# Development Topics — parent one level above the suite landing page
CONFLUENCE_PARENT_PAGE_ID=4620319
# Suite root landing page (AI Code Reviews - PR-Agent)
CONFLUENCE_ROOT_PAGE_ID=5347967000
CONFLUENCE_GITHUB_REPO=https://github.com/skatamatic/pr-agent
CONFLUENCE_GITHUB_REF=develop
CONFLUENCE_MERMAID_STRATEGY=png

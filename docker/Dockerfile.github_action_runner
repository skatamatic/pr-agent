# Use an official Python runtime as a parent image
# Match the Python version from your multi-stage file if desired
FROM python:3.12.10-slim

# Install git, as it's often needed by PR-Agent and was in your base stage
# This layer is fairly stable.
RUN apt-get update && apt-get install --no-install-recommends -y git curl && apt-get clean && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 1. Copy only the dependency definition file(s) first.
# This layer will only be invalidated if requirements.txt itself changes.
COPY requirements.txt ./
# If your project also strictly depends on pyproject.toml for dependency resolution via
# 'pip install -r requirements.txt', you might copy it here too:
# COPY pyproject.toml ./

# 2. Install Python dependencies.
# This expensive step will now only re-run if the 'requirements.txt' (and pyproject.toml if copied above)
# layer changes.
RUN pip install --no-cache-dir -r requirements.txt

# 3. Now, copy the rest of your application code.
# This layer will change more frequently (whenever your source code changes),
# but the 'pip install' layer above should remain cached if requirements haven't changed.
COPY . /app

# Ensure PYTHONPATH is set if your structure needs it (though /app is WORKDIR)
# Note: If you copied everything to /app, and your modules are in pr_agent within /app,
# Python should find them. Explicitly setting PYTHONPATH=/app might be redundant
# if your WORKDIR is /app and your code is structured directly in /app/pr_agent.
# However, it doesn't hurt if it was working for you.
ENV PYTHONPATH=/app

# Copy the existing entrypoint script
COPY github_action/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

# Set the entrypoint
ENTRYPOINT ["/entrypoint.sh"]
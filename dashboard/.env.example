# PR-Agent Dashboard - environment variable template
# Copy to .env and fill in values. Do not commit .env with real secrets.
#
# GCP deployment: set DATABASE_URL (Cloud SQL), DASHBOARD_CORS_ORIGINS (frontend URL),
# DASHBOARD_BACKEND_BASE_URL, DASHBOARD_FRONTEND_BASE_URL. See docs/GCP_DEPLOYMENT.md.

# ---------------------------------------------------------------------------
# Dashboard Backend
# ---------------------------------------------------------------------------
# Database: SQLite (default) or PostgreSQL (Cloud SQL)
# DATABASE_URL=sqlite:///./dashboard.db
DATABASE_URL=postgresql://user:password@localhost:5432/dashboard
# Alternative name (same effect): DASHBOARD_DATABASE_URL

# Server port (Cloud Run sets PORT automatically)
PORT=8000
# DASHBOARD_API_PORT=8000

# Base URLs for internal callbacks and frontend links (production: set to your deployed URLs)
DASHBOARD_BACKEND_BASE_URL=http://localhost:8000
DASHBOARD_FRONTEND_BASE_URL=http://localhost:3000

# CORS: comma-separated origins (required for GCP - set to your frontend URL)
# DASHBOARD_CORS_ORIGINS=http://localhost:3000
# GCP example: DASHBOARD_CORS_ORIGINS=https://dashboard-xxx.run.app

# Cron (for GCP Cloud Scheduler - trigger cleanup and job-timeout via HTTP)
# Set to a strong random value; required for POST /api/cron/run-cleanup and /api/cron/run-job-timeout
# DASHBOARD_CRON_SECRET=

# ---------------------------------------------------------------------------
# Dashboard Frontend (build-time only; used when running npm run build or Docker build)
# ---------------------------------------------------------------------------
REACT_APP_API_URL=http://localhost:8000
# Optional: WebSocket URL; if unset, derived from REACT_APP_API_URL (http -> ws, + /ws)
# REACT_APP_WS_URL=ws://localhost:8000/ws

# ---------------------------------------------------------------------------
# Dashboard API key (optional but recommended for GCP/container)
# ---------------------------------------------------------------------------
# When set, PR-Agent and cron/callbacks can use Bearer DASHBOARD_API_KEY instead of user JWT.
# GCP: set via Terraform variable dashboard_api_key or in Secret Manager (DASHBOARD_API_KEY).
# DASHBOARD_API_KEY=

# ---------------------------------------------------------------------------
# GCP runner VM on-demand provisioning (optional)
# ---------------------------------------------------------------------------
# When set, "Provision runner VM" in the dashboard creates GCE VMs for action runner connections.
# GCP Cloud Run: Terraform sets these from project_id/region/runner_zone. For local dev, set if testing.
# GCP_RUNNER_PROJECT_ID=
# GCP_RUNNER_REGION=us-central1
# GCP_RUNNER_ZONE=us-central1-a
# GCP_RUNNER_MACHINE_TYPE=e2-medium

# ---------------------------------------------------------------------------
# PR-Agent (when running PR-Agent and want it to report to this dashboard)
# ---------------------------------------------------------------------------
# DASHBOARD_URL=http://localhost:8000
# Use DASHBOARD_API_KEY above for Bearer token auth from PR-Agent.
